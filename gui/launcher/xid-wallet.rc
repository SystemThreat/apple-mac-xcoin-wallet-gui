// XID Wallet.exe resources. @VERSION@ and @VERSION_NUM@ (four comma-separated numbers) are filled in by
// gui/build-portable.sh. The icon is the first one, so Explorer, the taskbar and shortcuts all show it.
1 ICON "../assets/xid-wallet.ico"
1 24 "xid-wallet.manifest"

1 VERSIONINFO
FILEVERSION @VERSION_NUM@
PRODUCTVERSION @VERSION_NUM@
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "The xCoin (XID) developers"
      VALUE "FileDescription", "XID Wallet"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "xid-wallet"
      VALUE "LegalCopyright", "MIT License, (c) 2026 The xCoin (XID) developers"
      VALUE "OriginalFilename", "XID Wallet.exe"
      VALUE "ProductName", "XID Wallet"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
